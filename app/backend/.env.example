# Copia este archivo a ".env" y ajusta los valores. NO se sube a git.

# Base compartida de la firma (la misma del Conciliador / Documentos DIAN).
# Se le agrega automáticamente search_path=maestros.
CARDONA_DATABASE_URL=postgresql+psycopg://usuario:clave@servidor:5432/basecyc

# Alternativa: cadena completa propia (tiene prioridad sobre la anterior).
# DATABASE_URL=

# Llave Fernet ÚNICA de la firma (la MISMA de Documentos DIAN). Obligatoria con
# base compartida para poder descifrar las claves de portal ya cifradas.
FERNET_KEY=

# Secreto para firmar sesiones (JWT). Si se deja vacío, se genera y guarda local.
SESSION_SECRET=
